# PostgreSQL Connection Settings
# Copy this file to .env and fill in your actual values

PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_password_here
PG_DATABASE=postgres

# Path to PostgreSQL CSV log directory
# Default for PostgreSQL 16 on Windows:
PG_LOG_PATH=C:\\Program Files\\PostgreSQL\\16\\data\\log

# If you have a different version, adjust accordingly:
# PostgreSQL 15: C:\\Program Files\\PostgreSQL\\15\\data\\log
# PostgreSQL 17: C:\\Program Files\\PostgreSQL\\17\\data\\log
